# 公考智能解析助手 — 环境变量模板
# 
# 使用方法：复制此文件，重命名为 .env，然后填入你的真实 Key
#   cp .env.example .env
#
# ⚠️ 重要：.env 文件包含你的 API Key，绝对不要提交到 Git！

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-your_key_here

# 以下为可选配置
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Pro 深度评阅模式使用的模型（可选）
# 默认 deepseek-reasoner（推理模型，评阅更细但更贵/更慢）
DEEPSEEK_PRO_MODEL=deepseek-reasoner
